-- Quack server init script. Rendered from this template at container start
-- so QUACK_TOKEN can be injected from the environment.
--
-- The Quack extension is INSTALLed at image-build time (see Dockerfile)
-- so container start needs no network and the extension version is
-- frozen with the image; only LOAD remains here.

LOAD quack;

-- Seed sample analytics data.
.read /quack/seed.sql

-- The read-only authorization callback, on before any client connects (authz.sql says why it looks the way it does).
.read /quack/authz.sql

-- Start the Quack server. allow_other_hostname is required because
-- containerized clients connect via the docker network host name, not
-- 0.0.0.0. disable_ssl is true for this in-cluster demo; production
-- deployments should terminate TLS at a reverse proxy.
-- quack_serve's result row includes the token: keep it out of the container log.
.output /dev/null
CALL quack_serve(
    'quack:0.0.0.0:${QUACK_PORT}',
    token := '${QUACK_TOKEN}',
    allow_other_hostname := true,
    disable_ssl := true
);
.output
